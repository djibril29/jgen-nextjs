# =============================================================================
# J-GEN SENEGAL — variables d'environnement
# Copiez ce fichier vers .env.local et renseignez les valeurs réelles.
# .env.local n'est jamais versionné (voir .gitignore).
# =============================================================================

# --- Sanity CMS --------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Mailchimp (inscription newsletter depuis le site) -----------------------
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_API_SERVER=
MAILCHIMP_PETITION_AUDIENCE_ID=

# --- Resend (formulaire de contact) ------------------------------------------
RESEND_API_KEY=

# --- Upstash Redis / KV (compteur de pétition) -------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# --- URL publique du site ----------------------------------------------------
# Utilisée par la page newsletter et par le template e-mail pour produire des
# liens et des URL d'images ABSOLUES. Sans slash final.
#
# NEXT_PUBLIC_SITE_URL est lue par Next.js (navigateur + serveur).
NEXT_PUBLIC_SITE_URL=https://jgen.sn
#
# NEWSLETTER_SITE_URL est le repli pour le script Node `npm run email:generate`,
# qui s'exécute hors du bundle Next et ne voit pas forcément la variable ci-dessus.
# Laissez les deux identiques en production.
NEWSLETTER_SITE_URL=https://jgen.sn
